# ── LLM Provider ───────────────────────────────────────────────────
# LiteLLM model string (provider/model_name format).
# For custom OpenAI-compatible endpoints use the "openai/" prefix.
LLM_MODEL=openai/qwen/qwen3.6-35b-a3b
LLM_BASE_URL=http://192.168.50.91:1235/v1
LLM_API_KEY=
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
LLM_NUM_RETRIES=2

# ── Embedding Provider ─────────────────────────────────────────────
EMBEDDING_MODEL=openai/text-embedding-qwen3-embedding-4b
EMBEDDING_BASE_URL=http://192.168.50.91:1235/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=2560

# ── Bot Identity ───────────────────────────────────────────────────
BOT_NAME=mindcraft-bot
BOT_MAX_COMMANDS=3
BOT_NARRATE_BEHAVIOR=false
BOT_SHOW_COMMAND_SYNTAX=full
BOT_BLOCKED_ACTIONS=
BOT_ALLOW_VISION=false
BOT_SPAWN_TIMEOUT=60

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
