# ── LLM Provider ───────────────────────────────────────────────────
# LiteLLM model string (provider/model_name format).
# For custom OpenAI-compatible endpoints use the "openai/" prefix.
LLM_MODEL=openai/qwen/qwen3.6-35b-a3b
LLM_BASE_URL=http://192.168.50.91:1235/v1
LLM_API_KEY=
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
LLM_NUM_RETRIES=2

# ── Embedding Provider ─────────────────────────────────────────────
EMBEDDING_MODEL=openai/text-embedding-qwen3-embedding-4b
EMBEDDING_BASE_URL=http://192.168.50.91:1235/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=2560

# dispatch
DISPATCH_GATE_BASE_URL=http://127.0.0.1:1234
DISPATCH_GATE_MODEL=qwen/qwen3-4b-2507
DISPATCH_GATE_API_KEY=lm-studio
DISPATCH_GATE_TIMEOUT=5
DISPATCH_GATE_DIRECT_CONFIDENCE=0.85
DISPATCH_GATE_ENABLED=true

# ── Wiki RAG ───────────────────────────────────────────────────────
# Optional local Minecraft Wiki hybrid index. If data/wiki is missing or
# dependencies are not installed, searchWiki falls back to HTTP.
WIKI_RAG_ENABLED=true
WIKI_RAG_INDEX_DIR=data/wiki
# Remote ids work, or use local paths after running scripts/download_rag_models.py:
# WIKI_RAG_EMBED_MODEL=models/BAAI/bge-m3
# WIKI_RAG_RERANK_MODEL=models/BAAI/bge-reranker-v2-m3
WIKI_RAG_EMBED_MODEL=BAAI/bge-m3
WIKI_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
WIKI_RAG_USE_FP16=true
# Apple Silicon: auto selects MPS when torch reports it available.
WIKI_RAG_DEVICE=auto
WIKI_RAG_DENSE_CANDIDATES=50
WIKI_RAG_RERANK_CANDIDATES=20

# ── Bot Identity ───────────────────────────────────────────────────
BOT_NAME=mindcraft-bot
BOT_MAX_COMMANDS=3
BOT_NARRATE_BEHAVIOR=false
BOT_SHOW_COMMAND_SYNTAX=full
BOT_BLOCKED_ACTIONS=
BOT_ALLOW_VISION=false
BOT_SPAWN_TIMEOUT=60

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
